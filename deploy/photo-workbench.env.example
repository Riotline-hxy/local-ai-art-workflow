# Copy to /etc/photo-workbench.env on the server and chmod 0600.
# Keep API keys on the server; do not commit this file with real values.
NODE_ENV=production
NEXT_PUBLIC_BASE_PATH=/photo
NEXT_PUBLIC_IMAGE_STORAGE_MODE=fs
PHOTO_IMAGES_DIR=/srv/photo-workbench/generated-images
PHOTO_CONFIG_FILE=/srv/photo-workbench/runtime-config.json
PHOTO_ALLOW_REMOTE_CONFIG=1
PHOTO_PUBLIC_ORIGIN=https://strategy.noryx.cn
NEXT_TELEMETRY_DISABLED=1

# Image API
OPENAI_API_BASE_URL=https://api.example.com/v1
OPENAI_API_KEY=replace-with-image-api-key

# Text API used for chat and optional prompt refinement
PROMPT_REFINER_BASE_URL=https://api.example.com/v1
PROMPT_REFINER_API_KEY=replace-with-text-api-key
PROMPT_REFINER_MODEL=replace-with-text-model-id
PROMPT_REFINER_EFFORT=default
PROMPT_REFINER_ENABLED=0
NEXT_PUBLIC_PROMPT_REFINER_ENABLED=false

# Intentionally unset: this deployment is for trusted company users and has
# no application password or invitation-token gate.
# APP_PASSWORD=
# PHOTO_ACCESS_TOKEN=
# PHOTO_REQUIRE_ACCESS=0
